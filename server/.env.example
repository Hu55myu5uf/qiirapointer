PORT=5000
NODE_ENV=development            # use "production" on Render

# Firebase Configuration (or place firebase-service-account.json in server/ for local dev)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-client-email
FIREBASE_PRIVATE_KEY=your-private-key

# Supabase (being removed in Phase 2 — Firebase becomes the only backend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Security settings (added in the security hardening) ───────────────────
# Root admin account uid (Firebase Auth uid). Falls back to the original hard-coded uid if unset.
MASTER_ADMIN_UID=

# Secret used to sign short-lived in-call room tokens. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, a random secret is generated at startup (active calls drop when the server restarts).
CALL_TOKEN_SECRET=

# Browser origins allowed by CORS in production (comma-separated). The mobile app is unaffected.
ALLOWED_ORIGINS=

# Number of reverse-proxy hops in front of the server (Render = 1). Used to read the real client IP.
TRUST_PROXY=1

# Optional STUN/TURN servers for in-app calls (JSON array). A TURN server is added in Phase 4.
# ICE_SERVERS_JSON=[{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"}]

# Display email of the (login-disabled) Customer Support identity
SUPPORT_EMAIL=support@qiira.com
