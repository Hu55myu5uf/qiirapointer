{
  "expo": {
    "name": "Pointer",
    "slug": "qiira",
    "version": "1.1.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qiira.pointer",
      "buildNumber": "8",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Pointer uses your camera for video calls with businesses and to take photos for your posts, profile and identity verification.",
        "NSMicrophoneUsageDescription": "Pointer uses your microphone for voice and video calls with businesses and when recording videos for your posts."
      }
    },
    "android": {
      "package": "com.qiira.pointer",
      "versionCode": 8,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0742bccb-5172-4ff0-b58c-625e7be73b9a"
      }
    },
    "owner": "hussviin7",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pointer needs access to your photos so you can add pictures to your posts, profile, chats and identity verification.",
          "cameraPermission": "Pointer uses your camera so you can take photos for your posts, profile, chats and identity verification.",
          "microphonePermission": "Pointer uses your microphone to record sound when you film a video for a post."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pointer uses your location while you use the app to show businesses near you and, for vendors, to place your shop on the map.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Pointer uses your microphone for voice and video calls with businesses."
        }
      ],
      "expo-video",
      "expo-asset",
      "expo-font",
      "expo-status-bar",
      "expo-image",
      "@sentry/react-native",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#B28A45"
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/0742bccb-5172-4ff0-b58c-625e7be73b9a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
