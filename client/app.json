{
  "expo": {
    "name": "QIIRA",
    "slug": "qiira",
    "version": "1.0.1",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.qiira.pointer",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.qiira.pointer",
      "versionCode": 4,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyB8rHvWpp6SgCXvxxfmSQeGfX2vAdWfcBs"
        }
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "0742bccb-5172-4ff0-b58c-625e7be73b9a"
      }
    },
    "owner": "hussviin7",
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow QIIRA to access your camera to capture profile and post photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow QIIRA to access your photos to upload media."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow QIIRA to use your location to discover nearby businesses."
        }
      ]
    ]
  }
}
