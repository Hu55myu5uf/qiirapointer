rules_version = '2';

// QIIRA Firestore security rules
//
// All reads and writes go through the QIIRA API server, which uses the Firebase Admin SDK
// (the Admin SDK is not subject to these rules). The mobile app never accesses Firestore
// directly, so direct client access is denied everywhere.
//
// Previously, signed-in users could write their own `users` document — including `role: "admin"`,
// which the server trusts — and could read every conversation and message. Locking this down
// closes both holes.
//
// Phase 3 (real-time chat) will add narrow, read-only rules for conversation participants.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
